# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/

# CI4 writable (keep folder placeholders)
writable/cache/*
writable/logs/*
writable/session/*
writable/debugbar/*
writable/uploads/*
!writable/**/index.html
!writable/**/.htaccess
!writable/**/.gitkeep

# Local / editor
.idea/
.vscode/
.cursor/
.DS_Store
Thumbs.db
*.tar.gz

# Project
public/assets/img/_orig/
